BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated Telegram user IDs allowed to use the bot
ALLOWED_USER_IDS=123456789,987654321
# SQLite database path (relative to working dir, mounted as volume in compose)
DATABASE_PATH=data/notes.db

# Куда сохранять заметки: buildin (default) | notion.
NOTES_PROVIDER=buildin

# === Buildin (default provider) ===
# 1. Создать integration в Buildin → токен.
# 2. В каждом нужном workspace создать space, разрешить integration,
#    скопировать UUID space'а в соответствующий BUILDIN_SPACE_<WS>.
# 3. Запустить scripts/setup_buildin_dbs.py — он создаст недостающие DBs:
#       python -m scripts.setup_buildin_dbs >> .env
#    Если у вас уже есть готовые DBs — скопируйте их UUID руками
#    в BUILDIN_DB_<WS>_<TYPE> ДО запуска скрипта; он их не пересоздаст.
BUILDIN_TOKEN=

BUILDIN_SPACE_PERSONAL=
BUILDIN_SPACE_WORK=
BUILDIN_SPACE_FAMILY=
BUILDIN_SPACE_GROWTH=
BUILDIN_SPACE_AI_PATH=

# Fallback DB id, когда per-(workspace×type) и per-type не заданы.
BUILDIN_DB_DEFAULT=

# DB IDs per (workspace × type) — заполняются скриптом setup_buildin_dbs или руками.
# Формат: BUILDIN_DB_<WORKSPACE>_<NOTE_TYPE>=<uuid>
# Примеры:
# BUILDIN_DB_PERSONAL_NOTE=
# BUILDIN_DB_WORK_TASK=
# BUILDIN_DB_AI_PATH_IDEA=

# === Notion (legacy / fallback provider) ===
# NOTION_TOKEN + NOTION_DATABASE_ID — enable real saves в Notion.
# Per-type DB env vars (NOTION_DB_*) опциональные; unset типы фолбачатся на default.
#
# 1. Создать Internal Integration: https://www.notion.so/my-integrations
# 2. Для каждой DB которую хотите использовать: расшарить с integration
#    (… menu → Connections).
# 3. Скопировать database id из URL (32-char hex после workspace).
NOTION_TOKEN=
NOTION_DATABASE_ID=

NOTION_DB_NOTE=
NOTION_DB_TASK=
NOTION_DB_IDEA=
NOTION_DB_MEETING=
NOTION_DB_1ON1=
NOTION_DB_WORK=
NOTION_DB_PERSONAL=

# OpenAI. Empty → llm_processor stub (single 'note' type, body = raw text).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# AssemblyAI Universal-2 для транскрибации голоса/видео. Empty → voice/audio
# handlers отвечают "транскрибация выключена".
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_SPEECH_MODEL=universal
# "ru", "en", ... — пусто = autodetect (ненадёжно для <30 сек).
FORCE_LANGUAGE_CODE=
# Временные файлы (volume в compose).
TEMP_DIR=/tmp/notes-bot
