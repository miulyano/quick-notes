BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated Telegram user IDs allowed to use the bot
ALLOWED_USER_IDS=123456789,987654321
# SQLite database path (relative to working dir, mounted as volume in compose)
DATABASE_PATH=data/notes.db

# Notion. NOTION_TOKEN + NOTION_DATABASE_ID (default fallback) — enable real saves.
# Per-type DB env vars (NOTION_DB_*) are optional; unset types fall back to the
# default. Each type can live in its own database with its own schema (см. README).
#
# 1. Create an Internal Integration: https://www.notion.so/my-integrations
# 2. For every database you want to use: share it with this integration
#    (… menu → Connections).
# 3. Copy database ids from the URLs (the 32-char hex after the workspace).
NOTION_TOKEN=
NOTION_DATABASE_ID=

NOTION_DB_NOTE=
NOTION_DB_TASK=
NOTION_DB_IDEA=
NOTION_DB_MEETING=
NOTION_DB_1ON1=
NOTION_DB_WORK=
NOTION_DB_PERSONAL=

# OpenAI. Empty → llm_processor stub (single 'note' type, body = raw text).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# AssemblyAI Universal-2 для транскрибации голоса/видео. Empty → voice/audio
# handlers отвечают "транскрибация выключена".
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_SPEECH_MODEL=universal
# "ru", "en", ... — пусто = autodetect (ненадёжно для <30 сек).
FORCE_LANGUAGE_CODE=
# Временные файлы (volume в compose).
TEMP_DIR=/tmp/notes-bot
