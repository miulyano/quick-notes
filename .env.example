BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated Telegram user IDs allowed to use the bot
ALLOWED_USER_IDS=123456789,987654321
# SQLite database path (relative to working dir, mounted as volume in compose)
DATABASE_PATH=data/notes.db

# Куда сохранять заметки: notion (default) | buildin.
NOTES_PROVIDER=notion

# === Buildin ===
# 1. Создать integration в Buildin → токен.
# 2. В каждом нужном workspace создать space, разрешить integration,
#    скопировать UUID space'а в соответствующий BUILDIN_SPACE_<WS>.
# 3. Запустить scripts/setup_buildin_dbs.py — он создаст недостающие DBs:
#       python -m scripts.setup_buildin_dbs >> .env
#    Если у вас уже есть готовые DBs — скопируйте их UUID руками
#    в BUILDIN_DB_<WS>_<TYPE> ДО запуска скрипта; он их не пересоздаст.
BUILDIN_TOKEN=

BUILDIN_SPACE_PERSONAL=
BUILDIN_SPACE_WORK=
BUILDIN_SPACE_FAMILY=
BUILDIN_SPACE_GROWTH=
BUILDIN_SPACE_AI_PATH=

# Fallback DB id, когда per-(workspace×type) и per-type не заданы.
BUILDIN_DB_DEFAULT=

# DB IDs per (workspace × type) — заполняются скриптом setup_buildin_dbs или руками.
# Формат: BUILDIN_DB_<WORKSPACE>_<NOTE_TYPE>=<uuid>
# Примеры:
# BUILDIN_DB_PERSONAL_NOTE=
# BUILDIN_DB_WORK_TASK=
# BUILDIN_DB_AI_PATH_IDEA=

# === Notion (default provider) ===
# Резолв DB id для пары (workspace × type):
#   1) кэш (SQLite таблица notion_dbs)
#   2) NOTION_DB_<WS>_<TYPE> (env, например NOTION_DB_WORK_TASK)
#   3) NOTION_DB_<TYPE>      (per-type, без workspace-разреза)
#   4) NOTION_DATABASE_ID    (глобальный fallback)
#   5) lazy two-step auto-create под NOTION_PARENT_PAGE_<WS>:
#      pages.create (wrapper-page «📝 Заметки» / «✅ Задачи» / …) →
#      databases.create (full-page DB внутри wrapper). Структура зеркалит
#      Buildin: parent → 📝 Заметки → DB. database_id кэшируется на (1).
#
# Setup:
# 1. Создать Internal Integration в каждом нужном Notion workspace через
#    https://www.notion.so/my-integrations. Токен → NOTION_TOKEN_<WS>.
#    Если все NOTION_PARENT_PAGE_<WS> в одном Notion workspace — можно
#    обойтись одним legacy NOTION_TOKEN ниже.
# 2. Любой из:
#    - один NOTION_DATABASE_ID (минимум, всё упадёт туда), либо
#    - per-(ws×type) ids руками, либо
#    - NOTION_PARENT_PAGE_<WS> на каждый используемый workspace —
#      бот создаст wrapper-page + DB при первом hit и закэширует.
# 3. Каждая DB / parent-page расшарена с integration (… → Connections).
# Per-workspace integration tokens — рекомендуемый способ. Создать
# Internal Integration в каждом Notion workspace, где лежит соответствующий
# NOTION_PARENT_PAGE_<WS>, и расшарить parent-page с этим integration
# (... → Connections → Add). Заполнять только используемые workspaces.
NOTION_TOKEN_PERSONAL=
NOTION_TOKEN_WORK=
NOTION_TOKEN_FAMILY=
NOTION_TOKEN_GROWTH=
NOTION_TOKEN_AI_PATH=

# Legacy/fallback: один токен на все workspaces. Подходит, только если
# все NOTION_PARENT_PAGE_<WS> лежат в одном Notion workspace. Per-WS токен
# выше имеет приоритет.
# NOTION_TOKEN=
NOTION_DATABASE_ID=

# Lazy auto-create: parent-страница воркспейса. Под этой страницей бот
# создаст wrapper-page (📝 Заметки) и внутри неё — full-page DB при первом
# сохранении в (workspace=<ws>, type=<любой>). Если не задан — auto-create
# отключен для этого workspace, идёт fallback на NOTION_DATABASE_ID.
NOTION_PARENT_PAGE_PERSONAL=
NOTION_PARENT_PAGE_WORK=
NOTION_PARENT_PAGE_FAMILY=
NOTION_PARENT_PAGE_GROWTH=
NOTION_PARENT_PAGE_AI_PATH=

# Per-type DB ids — опционально, имеют приоритет ниже per-(ws×type) и кэша.
NOTION_DB_NOTE=
NOTION_DB_TASK=
NOTION_DB_IDEA=
NOTION_DB_MEETING=
NOTION_DB_1ON1=
NOTION_DB_WORK=
NOTION_DB_PERSONAL=
NOTION_DB_BOOK=

# Per-(workspace × type) DB ids — опционально, высший приоритет среди env.
# Формат: NOTION_DB_<WORKSPACE>_<NOTE_TYPE>=<uuid>
# Примеры:
# NOTION_DB_PERSONAL_NOTE=
# NOTION_DB_WORK_TASK=
# NOTION_DB_AI_PATH_IDEA=

# OpenAI. Empty → llm_processor stub (single 'note' type, body = raw text)
# + voice/audio/video handlers отвечают "транскрибация выключена".
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# STT-модель для голоса/видео:
#   gpt-4o-mini-transcribe — default, ~$0.003/мин, ~6% WER на русском (FLEURS).
#   gpt-4o-transcribe       — ~$0.006/мин, ~5% WER, для шумных записей.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# "ru", "en", ... — пусто = autodetect.
FORCE_LANGUAGE_CODE=
# Временные файлы (volume в compose).
TEMP_DIR=/tmp/notes-bot

# === Web App (Mini App) ===
# Поддомен с HTTPS, на котором лежит editor.html. Telegram-клиент откроет
# https://<WEBAPP_BASE_URL>/edit?draft_id=… по тапу «✏️ Edit». Если пусто —
# кнопка правки скрывается, aiohttp-сервер не стартует.
#
# Setup:
#  1. Поднять reverse-proxy (nginx/Caddy/traefik) на поддомене с TLS, который
#     проксирует на :WEBAPP_PORT контейнера бота.
#  2. В BotFather: /setdomain → указать поддомен из WEBAPP_BASE_URL.
#  3. (Опционально) /newapp — зарегистрировать Mini App с иконкой/именем.
WEBAPP_BASE_URL=
WEBAPP_BIND_HOST=0.0.0.0
WEBAPP_PORT=8080
