BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated Telegram user IDs allowed to use the bot
ALLOWED_USER_IDS=123456789,987654321
# SQLite database path (relative to working dir, mounted as volume in compose)
DATABASE_PATH=data/notes.db

# Notion. Both empty → bot stays in stub mode (logs page payload, returns
# fake page_id). Fill both to enable real saves.
# 1. Create an Internal Integration: https://www.notion.so/my-integrations
# 2. Copy the integration token here.
# 3. Create a database in Notion with three properties:
#      - "Name"      (title — required by Notion for any database)
#      - "Type"      (select)
#      - "CreatedAt" (date)
# 4. Share the database with your integration (… menu → Connections).
# 5. Copy the database id from the URL (the 32-char hex after the workspace).
NOTION_TOKEN=
NOTION_DATABASE_ID=
